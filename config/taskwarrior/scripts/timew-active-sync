#!/usr/bin/env python3
# Reconciles Timewarrior's single open interval with the union of tags from
# every currently-ACTIVE Taskwarrior task.
#
# Timewarrior can only track one open interval at a time -- `timew start`
# always closes whatever was already running (see `man timew-start`) -- so
# two tasks started in Taskwarrior at once can't become two literally
# overlapping Timewarrior intervals. This approximates concurrent tracking
# instead: whenever the set of active tasks changes, the current interval
# (if any) is closed and a new one opened tagged with every active task's
# tags. Each distinct combination of simultaneously-active tasks becomes its
# own interval, and each task's project/ticket gets full credit for however
# long it overlapped with the others -- the total across buckets can exceed
# wall-clock time, which is the expected tradeoff for tracking concurrent
# work with a tool that only has one clock.
#
# Idempotent -- safe to run any time, not just from the hook. Invoked
# (deferred, backgrounded) by on-modify-timewarrior after Taskwarrior
# commits a start/stop edge to disk.

import json
import os
import subprocess
from datetime import datetime, timezone

LOG_PATH = os.path.expanduser('~/.local/state/timew-active-sync.log')


def log_failure(command, result):
    os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
    with open(LOG_PATH, 'a') as f:
        f.write(f'{datetime.now(timezone.utc).isoformat()} failed: {" ".join(command)}\n')
        f.write(f'  stderr: {result.stderr.strip()}\n')


def extract_tags(task):
    tags = [task['description']]

    if 'project' in task:
        tags.append(task['project'])

    if 'ticket' in task:
        tags.append('ticket:' + task['ticket'])

    if 'tags' in task:
        value = task['tags']
        tags.extend(value.split(',') if isinstance(value, str) else value)

    return tags


def active_task_tags():
    output = subprocess.run(
        ['task', 'rc.verbose=nothing', '+ACTIVE', 'export'],
        capture_output=True, text=True, check=True,
    ).stdout
    tasks = json.loads(output) if output.strip() else []

    tags = set()
    for task in tasks:
        tags.update(extract_tags(task))
    return tags


def open_interval_tags():
    output = subprocess.run(
        ['timew', 'export', '@1'], capture_output=True, text=True,
    ).stdout
    intervals = json.loads(output) if output.strip() else []

    if not intervals or 'end' in intervals[0]:
        return None

    return set(intervals[0].get('tags', []))


def main():
    desired = active_task_tags()
    current = open_interval_tags()

    if current == desired:
        return

    if current is not None:
        result = subprocess.run(['timew', 'stop'], capture_output=True, text=True)
        if result.returncode != 0:
            log_failure(result.args, result)

    if desired:
        command = ['timew', 'start'] + sorted(desired) + [':yes']
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode != 0:
            log_failure(result.args, result)


if __name__ == '__main__':
    main()
