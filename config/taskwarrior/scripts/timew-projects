#!/bin/bash
# Summarizes Timewarrior time tracked per Taskwarrior project bucket.
#
# `timew summary` defaults to today only when given no range hint, but
# `timew export` defaults to all-time -- this uses export so an omitted
# range genuinely means "everything ever tracked" rather than silently
# scoping to today.
#
# `task _projects` only lists projects that appear on tasks matching the
# default (pending) filter, so a project whose only tasks are completed or
# deleted silently disappears. `rc.list.all.projects=1` on the `projects`
# report includes those too (context disabled so an active context can't
# hide any either); drop any project that comes back with zero tracked time.
#
# Usage: timew-projects [range hint...]
#   timew-projects                       all-time totals
#   timew-projects :week                 this week
#   timew-projects :month                this month
#   timew-projects 2026-08-01 to 2026-08-25

set -euo pipefail

command -v task >/dev/null 2>&1 || { echo "timew-projects: task not found" >&2; exit 1; }
command -v timew >/dev/null 2>&1 || { echo "timew-projects: timew not found" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || { echo "timew-projects: jq not found" >&2; exit 1; }

range=("$@")
total_secs=0
projects=()
secs_by_project=()

while IFS= read -r project; do
    [ -n "$project" ] || continue

    secs=$(timew export "${range[@]}" "$project" 2>/dev/null | jq '
        [.[] | (if .end then (.end | strptime("%Y%m%dT%H%M%SZ") | mktime)
                         else (now | floor) end)
             - (.start | strptime("%Y%m%dT%H%M%SZ") | mktime)]
        | add // 0')

    [ "$secs" -gt 0 ] || continue

    total_secs=$((total_secs + secs))
    projects+=("$project")
    secs_by_project+=("$secs")
done < <(task rc.context=none rc.verbose=nothing rc.list.all.projects=1 projects 2>/dev/null |
    awk '$0 ~ /^\(none\)/ { next } $0 ~ /^[A-Za-z0-9_.].*[0-9]+$/ { sub(/[ \t]+[0-9]+$/, ""); print }')

# percentages are of this report's own total, so they need the full total known before any row prints
for i in "${!projects[@]}"; do
    project="${projects[$i]}"
    secs="${secs_by_project[$i]}"
    pct=$(awk -v s="$secs" -v t="$total_secs" 'BEGIN { printf "%.1f", (t > 0 ? s * 100 / t : 0) }')
    printf '%-20s %02d:%02d:%02d  %5s%%\n' "$project" $((secs / 3600)) $((secs % 3600 / 60)) $((secs % 60)) "$pct"
done

printf -- '-%.0s' $(seq 1 37); echo
printf '%-20s %02d:%02d:%02d  %5s%%\n' "total" $((total_secs / 3600)) $((total_secs % 3600 / 60)) $((total_secs % 60)) "100.0"
