# Generic ssh config. Host-specific / work entries live in ~/.ssh/config.local
# (untracked or provided by the private overlay). Include is read first so
# its settings take precedence (ssh uses the first value it finds).
Include config.local

Host github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_personal
    IdentitiesOnly yes

Host *
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
