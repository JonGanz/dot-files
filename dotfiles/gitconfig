# Generic git settings. Identity is NOT stored here.
# Create the untracked per-machine file ~/.config/git/identity with:
#   [user]
#       name = Your Name
#       email = you@example.com
# (included below if present; git silently ignores a missing include)
# Work identity: ~/work/.gitconfig (overlay) is included for repos under ~/work/.

[alias]
	b = branch
	bl = branch -l
	blr = branch -l -r
	co = checkout
	cp = cherry-pick
	dd = difftool -d --ignore-submodules=all
	dds = difftool -d --cached --ignore-submodules=all
	df = difftool -y
	dfs = difftool -y --cached
	f = fetch -p
	mt = mergetool
	rbc = rebase --continue
	st = status

[core]
    editor = nvim -f
    symlinks = false

[diff]
	tool = bc3

[difftool "bc3"]
	cmd = BComp.exe "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)"

[merge]
	tool = bc3

[mergetool "bc3"]
	cmd = BComp.exe "$(wslpath -aw $LOCAL)" "$(wslpath -aw $REMOTE)" "$(wslpath -aw $BASE)" "$(wslpath -aw $MERGED)"

[pull]
	rebase = true

[include]
	path = ~/.config/git/identity

# Must come after the identity include so the work identity wins under ~/work/
[includeIf "gitdir:~/work/"]
	path = ~/work/.gitconfig
